# Copy to .env and fill in. .env is never committed.

# --- AI ---
GEMINI_API_KEY=paste-key-from-aistudio.google.com/apikey
# FOOD_AI_PROVIDER=gemini            # or "bedrock" (Claude on AWS, no audio)
# FOOD_GEMINI_MODEL=gemini-3.5-flash-lite
# FOOD_BEDROCK_MODEL_ID=
# FOOD_BEDROCK_REGION=ap-south-1
# FOOD_AI_TIMEOUT_SECONDS=60

# --- Local testing only (main.py sets these by default) ---
# FOOD_AUTH_MODE=dev                 # production: host
# FOOD_STORE=json                    # production: mongo
# FOOD_JSON_STORE_DIR=local_store

# --- Food database ---
# FOOD_USE_DATABASE=false            # true: INDB lookup + AI fallback; false: AI estimate only

# --- Privacy ---
# FOOD_STORE_DETAILS=false           # false: no learning data; meals keep names + 6 nutrients only
# FOOD_HISTORY_DAYS=30               # saved meals are auto-deleted after this many days
# FOOD_PENDING_MINUTES=60            # an unsaved scan is deleted after this long

# --- Matching (only used when FOOD_USE_DATABASE=true) ---
# FOOD_MATCH_AUTO_THRESHOLD=0.86     # >= this: accept the database match
# FOOD_MATCH_ASK_THRESHOLD=0.50      # between the two: ask the AI to choose

# --- Limits ---
# FOOD_MAX_ITEMS=15
# FOOD_MAX_IMAGE_BYTES=6291456
# FOOD_MAX_AUDIO_BYTES=10485760
# FOOD_RATE_LIMIT_PER_MINUTE=10
# FOOD_RATE_LIMIT_PER_DAY=150

# --- Learning from corrections ---
# FOOD_PROMOTE_MIN_USERS=3
# FOOD_PROMOTE_MIN_AGREEMENT=0.7
# FOOD_MIN_TRUST_FOR_GLOBAL=0.3
# FOOD_AUTO_PROMOTE=false
# FOOD_MAX_GLOBAL_CORRECTIONS_PER_DAY=30
